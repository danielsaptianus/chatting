generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enums
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum CommunityRole {
  COMMUNITY_OWNER
  COMMUNITY_ADMIN
  COMMUNITY_MEMBER
}

enum CallType {
  DIRECT
  GROUP
}

enum CallStatus {
  MISSED
  REJECTED
  COMPLETED
  BUSY
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  USER_REGISTERED
  ADDED_TO_GROUP
  REMOVED_FROM_GROUP
  USER_JOINED_GROUP
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  COMMUNITY_CREATED
  COMMUNITY_MEMBER_ADDED
  COMMUNITY_MEMBER_REMOVED
  CALL_INCOMING
  CALL_MISSED
}

// ============================================
// User & Profile Schema
// ============================================

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  biodata               Biodata?
  password_reset_tokens PasswordResetToken[]
  created_groups        Group[]              @relation("GroupCreator")
  group_memberships     GroupMember[]
  sent_group_messages   GroupMessage[]
  sent_direct_messages  DirectMessage[]      @relation("SentDirectMessages")
  received_direct_msgs  DirectMessage[]      @relation("ReceivedDirectMessages")
  notifications         Notification[]
  group_join_requests   GroupJoinRequest[]

  // Scoped Group Tenancy for ADMIN
  managed_group_id      Int?
  managed_group         Group?               @relation("ManagedGroupAdmin", fields: [managed_group_id], references: [id], onDelete: SetNull)

  // Community & Calls Relations
  created_communities   Community[]          @relation("CommunityCreator")
  community_memberships CommunityMember[]
  initiated_calls       CallSession[]        @relation("InitiatedCalls")
  received_calls        CallSession[]        @relation("ReceivedCalls")

  @@map("users")
}

model Biodata {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  first_name String
  last_name  String
  bio        String?  @db.VarChar(150)
  phone      String?
  avatar_url String?
  role       Role     @default(USER)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relation
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("biodata")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================
// Chat Schema
// ============================================

model Group {
  id                  Int       @id @default(autoincrement())
  name                String
  description         String?
  invite_code         String?   @unique
  created_by_id       Int
  is_announcement     Boolean   @default(false)
  only_admins_can_post Boolean  @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  creator         User               @relation("GroupCreator", fields: [created_by_id], references: [id])
  members         GroupMember[]
  messages        GroupMessage[]
  join_requests   GroupJoinRequest[]
  community_group CommunityGroup?
  call_sessions   CallSession[]
  managed_admins  User[]             @relation("ManagedGroupAdmin")

  @@map("groups")
}

model GroupMember {
  id        Int       @id @default(autoincrement())
  group_id  Int
  user_id   Int
  role      GroupRole @default(MEMBER)
  joined_at DateTime  @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@map("group_members")
}

model GroupJoinRequest {
  id         Int               @id @default(autoincrement())
  group_id   Int
  user_id    Int
  status     JoinRequestStatus @default(PENDING)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@map("group_join_requests")
}

model GroupMessage {
  id         Int      @id @default(autoincrement())
  group_id   Int
  sender_id  Int
  content    String
  created_at DateTime @default(now())

  group  Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("group_messages")
}

model DirectMessage {
  id          Int       @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  content     String
  is_read     Boolean   @default(false)
  read_at     DateTime?
  created_at  DateTime  @default(now())

  sender   User @relation("SentDirectMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedDirectMessages", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

// ============================================
// Community Schema
// ============================================

model Community {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  created_by_id Int
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  creator User              @relation("CommunityCreator", fields: [created_by_id], references: [id])
  members CommunityMember[]
  groups  CommunityGroup[]

  @@map("communities")
}

model CommunityMember {
  id           Int           @id @default(autoincrement())
  community_id Int
  user_id      Int
  role         CommunityRole @default(COMMUNITY_MEMBER)
  joined_at    DateTime      @default(now())

  community Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@map("community_members")
}

model CommunityGroup {
  id              Int      @id @default(autoincrement())
  community_id    Int
  group_id        Int      @unique
  is_announcement Boolean  @default(false)
  added_at        DateTime @default(now())

  community Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([community_id, group_id])
  @@map("community_groups")
}

// ============================================
// Call Session Schema
// ============================================

model CallSession {
  id          Int        @id @default(autoincrement())
  call_type   CallType   @default(DIRECT)
  caller_id   Int
  receiver_id Int?
  group_id    Int?
  status      CallStatus @default(COMPLETED)
  started_at  DateTime   @default(now())
  ended_at    DateTime?
  duration    Int        @default(0) // seconds

  caller   User   @relation("InitiatedCalls", fields: [caller_id], references: [id], onDelete: Cascade)
  receiver User?  @relation("ReceivedCalls", fields: [receiver_id], references: [id], onDelete: SetNull)
  group    Group? @relation(fields: [group_id], references: [id], onDelete: SetNull)

  @@map("call_sessions")
}

// ============================================
// Notification Schema
// ============================================

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  type       NotificationType
  title      String
  message    String
  is_read    Boolean          @default(false)
  metadata   Json?
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

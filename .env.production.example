# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (RENDER + NEON.TECH)
# ==============================================================================

# Application
NODE_ENV=production
PORT=3000
APP_NAME=ChatSphere

# Database (Neon PostgreSQL)
# Salin Connection String dari Dashboard Neon: Dashboard -> Quickstart / Connection Details -> Prisma / Postgres
DATABASE_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>.neon.tech/<NEON_DB>?sslmode=require"

# JWT Authentication (Sudah di-generate dengan crypto random string aman)
JWT_SECRET=3a07a98b2cab0b85a4812cc4764676a7b634fc0c42dbbaa0d20af72bbe7b2f60
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=f8f0303dc41f88e8f099bd4a33f67a27f1db90dd759d2d6ec7ac410588b1da98
JWT_REFRESH_EXPIRATION=30d

# CORS
# Masukkan domain Anda, atau gunakan '*' (sudah support credential reflection di backend)
# Contoh spesifik: https://chat.danielsaptianus.my.id,https://danielsaptianus.my.id
CORS_ORIGIN=*

# API
API_PREFIX=api

# Swagger API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
